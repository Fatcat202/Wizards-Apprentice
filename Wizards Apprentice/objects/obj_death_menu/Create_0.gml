// Menu Positionng
width = 250
height = 350
middle = global.cam_target_x + global.res_w/2
center = global.cam_target_y + global.res_h/2
pos_x = middle - width/2
pos_y = center - height/2


// Death Text
text_death_x = middle
text_death_y = pos_y + 50
text_death = "You Have Died!"



// Reload Game Button Pos
x_pos_reload = middle
y_pos_reload = pos_y + 260

// Main Menu Button Pos
x_pos_main_menu = middle
y_pos_main_menu = pos_y + 310

// Death Menu Image Pos
x_pos_death_image = middle
y_pos_death_image = center

// Fade in alpha
alpha = 0.0
alpha_increment = 0.005
