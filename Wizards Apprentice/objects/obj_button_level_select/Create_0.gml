/// @description

// Disable animation
image_speed = 0

// Set subimage based on room
image_index = room_num - slot_offset

// Surface for drawing
surf = -1

// Quick reference of sprite
sprite = sprite_index

// Quick reference of sprite size
width = sprite_width
height = sprite_height

// Subimage of level number to show
subimage = room_num - global.level_offset