
function scr_push_spell_data(spell_name)
{
	
	// Used for transfering spell data from scripts to objects when created
	
	spell_name.level = level
	spell_name.water_level = water_level
	spell_name.oil_level = oil_level
	spell_name.is_ice = is_ice
	spell_name.is_flaming = is_flaming
	spell_name.is_steaming = is_steaming
	spell_name.is_charged = is_charged
	spell_name.damage = damage
	spell_name.move_spd = move_spd
	spell_name.cooldown = cooldown
	spell_name.mana = mana
	spell_name.memory = memory
	spell_name.uses = uses
	spell_name.duration = duration
	spell_name.title = title
	spell_name.desc = desc
	spell_name.spr = spr
	spell_name.scr = scr
	spell_name.attack_spr = attack_spr
	
	
}